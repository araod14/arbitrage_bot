# =====================================================================
# Configuración del bot de monitoreo de arbitraje P2P Binance.
# Copia este archivo a `.env` y ajusta los valores. Todos son OPCIONALES:
# si falta uno, el bot lo pedirá por consola al arrancar usando estos
# valores como predeterminados (Enter = usar el default).
# =====================================================================

# --- Watch target (par a vigilar) ------------------------------------
ASSET=USDT
FIAT=VES

# Métodos de pago (identifiers de Binance) separados por coma.
# Déjalo vacío para que el bot autodescubra y te muestre un menú numerado.
# Ej: PagoMovil,Banesco,Mercantil
PAY_METHODS=

# --- Parámetros de arbitraje -----------------------------------------
# Monto máximo a mover, en USDT. Se usa para filtrar anuncios por límites.
MAX_USDT=100

# Umbral de ganancia neta (%) a partir del cual se avisa.
THRESHOLD_PCT=1.0

# Buffer (%) que se resta al spread para cubrir fees/slippage.
FEE_BUFFER_PCT=0.0

# Solo comerciantes verificados (true/false).
MERCHANT_CHECK=false

# --- Polling ----------------------------------------------------------
# Intervalo base entre ciclos, en segundos (se le aplica jitter).
POLL_INTERVAL_S=30

# --- Almacenamiento ---------------------------------------------------
# Ruta del archivo SQLite donde se guardan las oportunidades.
DB_PATH=opportunities.db

# Ruta del archivo de log.
LOG_PATH=p2p_arb_bot.log

# --- Red / anti-bloqueo ----------------------------------------------
# Objetivo de impersonation TLS de curl_cffi (chrome, chrome131, safari18_0...).
IMPERSONATE=chrome

# Proxy opcional (NO hardcodear credenciales en el código). Formato:
# http://user:pass@host:puerto  — se usa para todas las requests si está presente.
# También se respeta la estándar HTTPS_PROXY si esta está vacía.
PROXY=

# Sonido (beep) al detectar oportunidad (true/false).
BEEP=true

# Modo no interactivo: si es true, NO pregunta nada y usa solo estas vars.
NO_INPUT=false
