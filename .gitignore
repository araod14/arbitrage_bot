# Entornos virtuales
venv/
.venv/
env/

# Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Caché de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Configuración local y secretos (NO commitear credenciales)
.env

# Datos generados en runtime
*.db
*.sqlite
*.sqlite3
*.log
*.out
status.json
*.pid

# Fichas PNG por oportunidad (SCREENSHOTS_DIR local y mount de docker-compose)
screenshots/
capturas_oportunidades/

# Ajustes locales de Claude Code (permisos de esta máquina, no del proyecto).
# El settings.json compartido sí se commitea; el .local y los temporales que
# deja su escritura atómica, no.
.claude/settings.local.json
.claude/*.tmp.*

# Editores / SO
.idea/
.vscode/
*.swp
.DS_Store
