{
  "permissions": {
    "allow": [
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_close",
      "Bash(git check-ignore *)",
      "Bash(docker exec *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:8899/)",
      "Bash(timeout 300 docker compose up -d --build)",
      "mcp__playwright__browser_evaluate",
      "Bash(venv/bin/python -m pytest -q)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
